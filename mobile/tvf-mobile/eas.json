{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_TVF_CONTACT_API_URL": "https://www.territoiresvivantsfrance.fr/api/contact"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_TVF_CONTACT_API_URL": "https://www.territoiresvivantsfrance.fr/api/contact"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_TVF_CONTACT_API_URL": "https://www.territoiresvivantsfrance.fr/api/contact"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
