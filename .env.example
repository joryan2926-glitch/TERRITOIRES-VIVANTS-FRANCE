# Notifications transactionnelles
RESEND_API_KEY=
TVF_EMAIL_FROM=Territoires Vivants France <notifications@territoiresvivantsfrance.fr>
TVF_EMAIL_REPLY_TO=contact@territoiresvivantsfrance.fr
TVF_NOTIFICATION_EMAIL=territoiresvivantsfrance@gmail.com
