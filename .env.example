TVF_OUTBOUND_TIMEOUT_MS=9000
TVF_EMAIL_WEBHOOK_SECRET=
EXPO_PUBLIC_TVF_CONTACT_API_URL=https://www.territoiresvivantsfrance.fr/api/contact

# Acces TVF OS - generer une valeur longue et aleatoire
TVF_ADMIN_TOKEN=

# Integrations optionnelles, a laisser vides tant qu'elles ne sont pas activees
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Limitation anti-abus par instance serveur
